generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  PLAYER
}

enum MatchTag {
  PRACTICE
  LIVE
}

enum MatchType {
  SINGLES
  DOUBLES
}

enum TournamentFormat {
  SINGLES
  DOUBLES
}

enum TournamentStatus {
  DRAFT
  ONGOING
  FINISHED
}

enum MatchReportStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuditAction {
  MATCH_REPORT_APPROVED
  MATCH_REPORT_REJECTED
  PLAYER_ACCOUNT_CREATED
  PLAYER_ACCOUNT_UPDATED
  DATA_IMPORTED
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         UserRole @default(PLAYER)
  playerId     String?  @unique
  player       Player?  @relation(fields: [playerId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submittedReports MatchReport[] @relation("SubmittedReports")
  reviewedReports  MatchReport[] @relation("ReviewedReports")
  auditLogs        AuditLog[]
  createdShameRecords ShameRecord[] @relation("CreatedShameRecords")
}

model Player {
  id             String    @id @default(cuid())
  name           String
  hidden         Boolean   @default(false)
  retired        Boolean   @default(false)
  retirementNote String?
  retiredAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User?

  leftMatches     Match[] @relation("LeftPlayerMatches")
  rightMatches    Match[] @relation("RightPlayerMatches")
  wonMatches      Match[] @relation("WinnerMatches")
  handicapGiven   Match[] @relation("HandicapGiverMatches")
  handicapReceived Match[] @relation("HandicapReceiverMatches")

  leftReports      MatchReport[] @relation("LeftPlayerReports")
  rightReports     MatchReport[] @relation("RightPlayerReports")
  wonReports       MatchReport[] @relation("WinnerReports")
  handicapReportGiven    MatchReport[] @relation("HandicapGiverReports")
  handicapReportReceived MatchReport[] @relation("HandicapReceiverReports")

  shameLosses         ShameRecord[] @relation("ShameLoser")
  shameParticipations ShameRecord[] @relation("ShameParticipants")

  highlightMatches Match[] @relation("PlayerHighlights")
}

model Match {
  id                 String   @id @default(cuid())
  matchName          String
  dateISO            DateTime
  raceTo             Int
  leftPlayerId       String
  rightPlayerId      String
  leftScore          Int
  rightScore         Int
  winnerId           String?
  tag                MatchTag @default(PRACTICE)
  matchType          MatchType @default(SINGLES)
  leftPlayer2Id      String?
  rightPlayer2Id     String?
  isHandicap         Boolean  @default(false)
  handicapGiverId    String?
  handicapReceiverId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  leftPlayer       Player @relation("LeftPlayerMatches", fields: [leftPlayerId], references: [id], onDelete: Restrict)
  rightPlayer      Player @relation("RightPlayerMatches", fields: [rightPlayerId], references: [id], onDelete: Restrict)
  winner           Player? @relation("WinnerMatches", fields: [winnerId], references: [id], onDelete: SetNull)
  handicapGiver    Player? @relation("HandicapGiverMatches", fields: [handicapGiverId], references: [id], onDelete: SetNull)
  handicapReceiver Player? @relation("HandicapReceiverMatches", fields: [handicapReceiverId], references: [id], onDelete: SetNull)
  sourceReport     MatchReport? @relation("ApprovedMatch")
  highlightedBy    Player[] @relation("PlayerHighlights")

  @@index([dateISO])
  @@index([tag])
  @@index([leftPlayerId])
  @@index([rightPlayerId])
}

model MatchReport {
  id                 String            @id @default(cuid())
  matchName          String
  dateISO            DateTime
  raceTo             Int
  leftPlayerId       String
  rightPlayerId      String
  leftScore          Int
  rightScore         Int
  winnerId           String?
  tag                MatchTag          @default(PRACTICE)
  matchType          MatchType         @default(SINGLES)
  leftPlayer2Id      String?
  rightPlayer2Id     String?
  isHandicap         Boolean           @default(false)
  handicapGiverId    String?
  handicapReceiverId String?
  status             MatchReportStatus @default(PENDING)
  submittedById      String
  reviewedById       String?
  reviewedAt         DateTime?
  rejectionReason    String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  submittedBy      User   @relation("SubmittedReports", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedBy       User?  @relation("ReviewedReports", fields: [reviewedById], references: [id], onDelete: SetNull)
  leftPlayer       Player @relation("LeftPlayerReports", fields: [leftPlayerId], references: [id], onDelete: Restrict)
  rightPlayer      Player @relation("RightPlayerReports", fields: [rightPlayerId], references: [id], onDelete: Restrict)
  winner           Player? @relation("WinnerReports", fields: [winnerId], references: [id], onDelete: SetNull)
  handicapGiver    Player? @relation("HandicapGiverReports", fields: [handicapGiverId], references: [id], onDelete: SetNull)
  handicapReceiver Player? @relation("HandicapReceiverReports", fields: [handicapReceiverId], references: [id], onDelete: SetNull)
  approvedMatch    Match? @relation("ApprovedMatch", fields: [approvedMatchId], references: [id], onDelete: SetNull)
  approvedMatchId  String? @unique

  @@index([status])
  @@index([submittedById])
  @@index([dateISO])
}

model AuditLog {
  id        String      @id @default(cuid())
  action    AuditAction
  actorId   String?
  targetId  String?
  detail    String?
  createdAt DateTime    @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
}

model ShameRecord {
  id          String   @id @default(cuid())
  dateISO     DateTime
  loserId     String
  pins        Int
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  loser        Player   @relation("ShameLoser", fields: [loserId], references: [id], onDelete: Restrict)
  participants Player[] @relation("ShameParticipants")
  createdBy    User?    @relation("CreatedShameRecords", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([dateISO])
  @@index([loserId])
}

model Tournament {
  id          String           @id @default(cuid())
  name        String
  format      TournamentFormat @default(SINGLES)
  status      TournamentStatus @default(DRAFT)
  raceTo      Int              @default(7)
  tag         MatchTag         @default(PRACTICE)
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  participants TournamentParticipant[]
  matches      TournamentMatch[]
}

// 参赛者。playerId / teammateId 用纯标量（不建 Player 外键），赛事为临时对阵数据，
// 完整性由应用层保证；删比赛时靠 tournamentId 级联清理。
model TournamentParticipant {
  id           String   @id @default(cuid())
  tournamentId String
  playerId     String
  teammateId   String?  // 仅双打：与之组队的另一名 playerId
  seed         Int?
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, playerId])
  @@index([tournamentId])
}

// 对阵图节点。a1/a2 = A 队，b1/b2 = B 队（单打只用 a1/b1）。
// winnerSide = "A" | "B"；胜者经 nextMatchId + nextSlot 进位到下一轮。
model TournamentMatch {
  id              String   @id @default(cuid())
  tournamentId    String
  round           Int
  slotIndex       Int
  a1Id            String?
  a2Id            String?
  b1Id            String?
  b2Id            String?
  leftScore       Int?
  rightScore      Int?
  winnerSide      String?
  status          String   @default("PENDING") // PENDING | DONE
  nextMatchId     String?
  nextSlot        String?  // "A" | "B"：胜者填入下一场的哪个队槽
  approvedMatchId String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
}
